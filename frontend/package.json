{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "codegen": "openapi-typescript openapi.json -o src/types/api.generated.ts",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@lucide/vue": "^1.22.0",
    "@tanstack/vue-query": "^5.108.1",
    "@tanstack/vue-virtual": "^3.13.52",
    "@vueuse/core": "^15.0.0",
    "cronstrue": "^3.43.0",
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.38",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
