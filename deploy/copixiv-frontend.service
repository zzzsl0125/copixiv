# Production unit for the copixiv frontend — build + static preview, NOT `npm run dev`.
#
# Install:
#   sudo cp deploy/copixiv-frontend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl stop copixiv-frontend   # stop the old dev-server unit first
#   sudo systemctl start copixiv-frontend
#
# `vite preview` serves frontend/dist/ and proxies /api -> 127.0.0.1:9000
# (preview.proxy in vite.config.ts), so the browser talks to the backend
# same-origin exactly like the dev server did.
#
# Optional hardening: swap the ExecStart for nginx serving frontend/dist/
# with a location /api proxy to the backend.  vite preview is a static
# file server built for previewing builds — fine for a single-user tool,
# but nginx (or caddy) is the better long-term option for TLS/compression.

[Unit]
Description=Frontend of Copixiv (production: build + vite preview)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=invocation
Group=invocation
WorkingDirectory=/home/invocation/copixiv/frontend/
# Rebuild the bundle on every start so dist/ always matches the tree.
# Remove this line if you build manually.
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npm run preview

# vue-tsc + vite build can take a while on cold cache — don't let the
# default 90s timeout kill a legitimate build.
TimeoutStartSec=180

# Debugging a failed start:
#   journalctl -xeu copixiv-frontend.service -n 80 --no-pager
#   cd /home/invocation/copixiv-frontend && npm run build   # manual build error
#   ss -tlnp | grep 5173                                    # stale dev server?
#   # If 5173 is held by an old `vite` dev process not owned by systemd:
#   #   pkill -f "vite"   (then systemctl start copixiv-frontend)

Restart=on-failure
RestartSec=5s

StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
