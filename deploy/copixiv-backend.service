# Production unit for the copixiv backend (postgres-migration).
#
# The application now reads PostgreSQL via ``config.yaml`` ``database_url``
# (default: postgresql+psycopg2://postgres@127.0.0.1:5433/copixiv) — there is
# NO system-level PostgreSQL service on this host; the database runs as a
# pgserver instance inside the project venv (data dir .spike/pgdata, managed
# by scripts/pg_dev.py, port 5433).  ExecStartPre therefore brings the
# database up before the app boots, so a plain
#
#     sudo systemctl restart copixiv-backend
#
# is fully self-sufficient (idempotent: exits 0 when Postgres already runs).
# This also covers cold boot: the unit is enabled, so after a reboot systemd
# starts the backend, and ExecStartPre starts Postgres first.
#
# Restart policy is ``always``, deliberately NOT ``on-failure``:
# systemd treats SIGHUP/SIGINT/SIGTERM/SIGPIPE as *clean* exits for
# Type=simple services, and ``Restart=on-failure`` explicitly excludes those
# four signals (systemd.service(5)).  An externally delivered SIGTERM — e.g. a
# stray kill/pkill — therefore leaves the unit dead with ``Result=success``
# and ``NRestarts=0``, and nothing ever brings it back.  Observed twice on this
# host: 2026-09-10 07:04:48 and 2026-09-12 07:04:55, the latter leaving the API
# dead for ~22h (see INCIDENT-2026-09-12-copixiv-backend-down.md).
# ``always`` restarts on any exit; a systemd-initiated stop/restart is still
# honoured (systemd never restarts a unit it stopped itself).
#
# Install (needs sudo — the checked-in copy is the source of truth):
#   sudo cp deploy/copixiv-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart copixiv-backend
#
# Debugging:
#   journalctl -xeu copixiv-backend.service -n 80 --no-pager
#   python scripts/pg_dev.py status   # database health/port

[Unit]
Description=Backend of Copixiv
# Rate limits for the Restart= loop below.  Both keys belong to [Unit]: in
# [Service] systemd ignores them with "Unknown key name ... ignoring" (which
# is exactly where they used to live, so the limits never applied).
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=invocation
Group=invocation
WorkingDirectory=/home/invocation/copixiv/
# Ensure the local PostgreSQL (pgserver) instance is running before the app
# boots.  Idempotent: returns 0 immediately when the server is already up.
ExecStartPre=/home/invocation/copixiv/.venv/bin/python /home/invocation/copixiv/scripts/pg_dev.py start
ExecStart=/home/invocation/copixiv/.venv/bin/python -u main.py

# Covers every exit — including a clean SIGTERM exit that on-failure ignores.
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
