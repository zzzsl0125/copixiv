# copixiv 应用部署单元：**一个进程同时提供 API 与前端**（:9000）。
# 数据库由独立的 copixiv-pg.service 托管监管（Requires=copixiv-pg.service）。
#
# 安装（需要 sudo）：
#   # 1) 安装依赖（含 local-pg extra）、编译 Rust 扩展与构建前端
#   #    （详见 README；前端产物不要放进 ExecStartPre）
#   cd /home/invocation/project/copixiv/frontend && npm run build
#   # 2) 安装双单元
#   sudo cp /home/invocation/project/copixiv/deploy/copixiv-pg.service /etc/systemd/system/
#   sudo cp /home/invocation/project/copixiv/deploy/copixiv.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   # 3) 若此前曾由旧版 copixiv.service 拉起过后台 pg_ctl，先 stop 一次释放端口/PID：
#   #    .venv/bin/python scripts/pg_dev.py stop
#   sudo systemctl enable --now copixiv-pg.service
#   sudo systemctl restart copixiv.service
#
# 前端源码改动后：`cd frontend && npm run build` 即可，**不需要**重启服务
# （后端每次请求都从磁盘读 dist；index.html 带 no-cache，哈希资源带 immutable）。

[Unit]
Description=Copixiv (API + frontend, single process)
Requires=copixiv-pg.service
After=network-online.target copixiv-pg.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=invocation
Group=invocation
WorkingDirectory=/home/invocation/project/copixiv
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/invocation/project/copixiv/.venv/bin/python -u main.py
Restart=always
RestartSec=5s
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
